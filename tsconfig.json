{
    "compilerOptions": {
        "declaration": true,
        "target": "esnext",
        "lib": ["esnext", "dom"],
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "allowJs": true,
        "moduleResolution": "bundler",
        "outDir": "dist",
        "resolveJsonModule": true,
        "emitDeclarationOnly": true,
        "types": ["node"],
    },
    "include": ["src/*.ts"],
}
